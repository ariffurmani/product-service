      "name": "Create Products",
      "item": [
        {
          "name": "Create Product - iPhone 15",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('product_id_1', jsonData.id);",
                  "    console.log('Product 1 created with ID:', jsonData.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"price\": 1099.99,\n  \"description\": \"Apple smartphone with 6.1-inch Liquid Retina display\",\n  \"category\": \"electronics\",\n  \"imageUrl\": \"https://example.com/images/iphone15.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
